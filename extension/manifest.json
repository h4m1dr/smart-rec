{
  "manifest_version": 3,
  "name": "React Direct-Disk Cloner",
  "version": "4.0.0",
  "description": "Directly maps React/MUI apps file-by-file onto your local disk with full project awareness.",
  "permissions": ["activeTab", "scripting", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_hook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Smart-Rec: React SPA Cloner",
  "version": "6.0.0",
  "description": "Whitelisted React/MUI cloner with pre-flight site analyzer, error console, offline SPA router & AI Master Bundle.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Smart-Rec Controller",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_hook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}

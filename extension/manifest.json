{
  "manifest_version": 3,
  "name": "Smart-Rec: SPA State Mapper",
  "version": "2.0.0",
  "description": "Incremental React/MUI DOM, CSSOM, and API state harvester for modular cloning.",
  "permissions": ["activeTab", "scripting", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_hook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}

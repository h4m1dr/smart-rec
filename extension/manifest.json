{
  "manifest_version": 3,
  "name": "Smart-Rec v7.0: AI WebUI Architect",
  "version": "7.0.0",
  "description": "Wappalyzer-grade site passport, PNG screenshotter, micro-element scanner & modular AI specification generator.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Smart-Rec v7.0 Architect",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_hook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
